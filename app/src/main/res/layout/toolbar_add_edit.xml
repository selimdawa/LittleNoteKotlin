<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolbar_height"
    android:layout_margin="@dimen/spacing_10"
    android:visibility="visible"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:strokeWidth="0dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?mc_bg"
        android:visibility="visible">

        <ImageView
            android:id="@+id/add"
            android:layout_width="@dimen/spacing_30_sp"
            android:layout_height="@dimen/spacing_30_sp"
            android:layout_gravity="start"
            android:layout_marginEnd="@dimen/spacing_15_sp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/nameSpace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_21"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/info"
            android:layout_width="@dimen/spacing_30_sp"
            android:layout_height="@dimen/spacing_30_sp"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/spacing_15_sp"
            android:contentDescription="@string/cd_info"
            android:src="@drawable/ic_info"
            android:visibility="gone"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="@dimen/spacing_30_sp"
            android:layout_height="@dimen/spacing_30_sp"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/spacing_15_sp"
            android:contentDescription="@null"
            android:visibility="gone"
            app:tint="@color/white" />

    </com.google.android.material.appbar.MaterialToolbar>

</com.google.android.material.card.MaterialCardView>