<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.flatcode.littlenote.ui.splash.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/activity_splash">
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.flatcode.littlenote.ui.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/activity_home">
        <action
            android:id="@+id/action_homeFragment_to_splashFragment"
            app:destination="@id/splashFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_homeFragment_to_addNoteFragment"
            app:destination="@id/addNoteFragment" />
        <action
            android:id="@+id/action_homeFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_editNoteFragment"
            app:destination="@id/editNoteFragment" />
        <action
            android:id="@+id/action_homeFragment_to_noteDetailsFragment"
            app:destination="@id/noteDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.flatcode.littlenote.ui.auth.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/activity_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_forgetPasswordFragment"
            app:destination="@id/forgetPasswordFragment" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.flatcode.littlenote.ui.auth.RegisterFragment"
        android:label="RegisterFragment"
        tools:layout="@layout/activity_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgetPasswordFragment"
        android:name="com.flatcode.littlenote.ui.auth.ForgetPasswordFragment"
        android:label="ForgetPasswordFragment"
        tools:layout="@layout/activity_forget_password">
        <action
            android:id="@+id/action_forgetPasswordFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_forgetPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/addNoteFragment"
        android:name="com.flatcode.littlenote.ui.note.AddNoteFragment"
        android:label="AddNoteFragment"
        tools:layout="@layout/activity_add_edit_note" />

    <fragment
        android:id="@+id/editNoteFragment"
        android:name="com.flatcode.littlenote.ui.note.EditNoteFragment"
        android:label="EditNoteFragment"
        tools:layout="@layout/activity_add_edit_note" />

    <fragment
        android:id="@+id/noteDetailsFragment"
        android:name="com.flatcode.littlenote.ui.note.NoteDetailsFragment"
        android:label="NoteDetailsFragment"
        tools:layout="@layout/activity_note_details">
        <action
            android:id="@+id/action_noteDetailsFragment_to_editNoteFragment"
            app:destination="@id/editNoteFragment" />
    </fragment>

</navigation>